# Maintainer: kasamorin
#
# Builds from the GitHub tag source tarball. Run from pkg/:
#   makepkg -si
#
# sha256sums is SKIP because this package is not submitted to AUR; the source
# is downloaded directly from the project's own GitHub release tag.

pkgname=digital-wellbeing
_pkgver=1.0.0
pkgver=$_pkgver
pkgrel=1
pkgdesc="番茄工作法休息提醒，Qt6 全屏覆盖窗口"
arch=('x86_64' 'aarch64')
url="https://github.com/kasamorin/digital-wellbeing"
license=('GPL3')
depends=('json-c' 'qt6-base' 'libnotify')
makedepends=('gcc' 'make' 'gettext')
options=('!debug')
provides=('digital-wellbeing')
conflicts=()

source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
  cd "$srcdir/$pkgname-$pkgver"
  make
}

package() {
  cd "$srcdir/$pkgname-$pkgver"
  make install PREFIX=/usr DESTDIR="$pkgdir"
}
